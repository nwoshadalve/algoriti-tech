# Copy to `.env.development` for local work (never commit secrets).

# Direct tablet URL (cross-origin from localhost:5173; debug APK reflects CORS).
# Leave empty to use the Vite proxy (recommended — no CORS):
# VITE_API_ORIGIN=
VITE_API_ORIGIN=https://algoritiq.local:8443

# Vite proxy target when VITE_API_ORIGIN is empty (forwards /api → tablet)
VITE_API_PROXY=https://algoritiq.local:8443

# Path segment after the origin (production: relative `/api/v1` on the tablet host)
VITE_API_BASE_PATH=/api/v1
